# VCS / tooling
.git
.github
.vscode
.DS_Store
*.log

# Installed / built artefacts (rebuilt inside the image)
node_modules
.next
out
coverage
playwright-report
test-results
tsconfig.tsbuildinfo

# Secrets — never bake env files into an image
.env
.env.*
!.env.example
deploy/.env

# Hosting leftovers and deploy-only files
.vercel
deploy

# Not needed at runtime
__tests__
scripts/*.png
*.md
!README.md
