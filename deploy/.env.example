# GrantPilot VPS stack — copy to deploy/.env, then run ./generate-keys.sh to fill
# every "change-me" secret. Never commit deploy/.env.

############ Domain / URLs
# Public hostname (DNS A/AAAA record -> this VPS). Caddy gets the TLS cert.
APP_DOMAIN=grantpilot.example.com
ACME_EMAIL=ops@example.com
# Browser-facing app URL. Also GoTrue's SITE_URL (email links land here).
SITE_URL=https://grantpilot.example.com
# Supabase API base URL. Same domain: Caddy routes /auth/v1 and /rest/v1 to Kong.
SUPABASE_PUBLIC_URL=${SITE_URL}
# Extra comma-separated redirect URLs GoTrue may send users to (optional).
ADDITIONAL_REDIRECT_URLS=
APP_NAME="GrantPilot AI"

############ Supabase secrets (./generate-keys.sh)
POSTGRES_PASSWORD=change-me
# >= 32 chars. ANON_KEY / SERVICE_ROLE_KEY are HS256 JWTs signed with it —
# regenerate them together (./generate-keys.sh --force) if you rotate it.
JWT_SECRET=change-me
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
JWT_EXPIRY=3600
# Basic-auth for Studio (only reachable via SSH tunnel to 127.0.0.1:8000).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me
PG_META_CRYPTO_KEY=change-me

############ Auth email (GoTrue SMTP — confirmation + password reset)
# Resend works: host smtp.resend.com, port 465/587, user "resend", pass = API key.
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_key_here
SMTP_SENDER_NAME="GrantPilot AI"
# true = skip email confirmation on signup (only for testing).
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false

############ Google OAuth (optional)
# Authorized redirect URI in Google Cloud: ${SITE_URL}/auth/v1/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

############ Embeddings (Ollama, in-stack)
EMBEDDING_MODEL=bge-m3

############ App secrets
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
RESEND_API_KEY=re_your_key_here
EMAIL_FROM="GrantPilot <noreply@example.com>"
SAM_GOV_API_KEY=
RSS_FEED_URLS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
# Bearer token for the manual /api/cron/* triggers.
CRON_SECRET=change-me

############ Ports bound on 127.0.0.1 (SSH-tunnel access only)
POSTGRES_HOST_PORT=5432
KONG_HOST_PORT=8000
IMAGE_TAG=latest
