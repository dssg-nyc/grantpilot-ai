# Local development env — copy to .env.local.
# Production (VPS) env lives in deploy/.env — see deploy/.env.example and DEPLOY.md.

# Supabase (self-hosted stack, or `supabase start` locally)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Direct Postgres connection — pg-boss job queue (web enqueues, worker consumes)
DATABASE_URL=postgres://postgres:your_postgres_password@127.0.0.1:5432/postgres

# AI
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Embeddings (local Ollama; `ollama pull bge-m3` — 1024-dim, matches vector(1024))
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=you@yourdomain.com

# Grants.gov (SAM.gov)
SAM_GOV_API_KEY=your_sam_gov_api_key
# Optional comma-separated RSS feeds for monitor-rss
RSS_FEED_URLS=

# Billing (Stripe)
STRIPE_SECRET_KEY=sk_test_your_key_here # Stripe Dashboard -> Developers -> API keys
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret # Stripe Dashboard -> Developers -> Webhooks -> select endpoint -> Signing secret
STRIPE_PRICE_ID_PRO=price_your_pro_plan_price_id # Stripe Dashboard -> Products -> Pro plan -> Price ID

# App
NEXT_PUBLIC_APP_URL=http://localhost:3030
NEXT_PUBLIC_APP_NAME="GrantPilot AI"
CRON_SECRET=your_random_secret_here
